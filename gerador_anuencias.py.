"""
MÓDULO DE GERAÇÃO E ANÁLISE DE ANUÊNCIAS VIA GEMINI API
Criação automatizada de Declarações de Reconhecimento de Limites baseada em modelos.
"""

import io
import json
import logging
from docx import Document
from docx.shared import Pt, Inches
from docx.enum.text import WD_ALIGN_PARAGRAPH
import google.generativeai as genai
import streamlit as st

logger = logging.getLogger(__name__)

class GeradorAnuenciaWord:
    def __init__(self, dados_empresa: dict, dados_tecnico: dict):
        self.dados_empresa = dados_empresa
        self.dados_tecnico = dados_tecnico
        
        # Configura a API do Gemini usando a chave central dos Secrets do Streamlit
        self.api_key = st.secrets.get("GEMINI_API_KEY")
        if self.api_key:
            genai.configure(api_key=self.api_key)

    def analisar_e_estruturar_texto(self, confrontante: str, dados_memorial: dict, segmentos: list) -> str:
        """
        Utiliza a API do Gemini para gerar a descrição textual fluida do trecho de confrontação,
        garantindo a qualidade técnica da redação jurídica/topográfica.
        """
        if not self.api_key:
            return f"De comum acordo, o perímetro confronta com {confrontante} nos vértices citados na tabela abaixo."

        try:
            # Formata os segmentos em string para a IA ler
            linhas_trecho = []
            for s in segmentos:
                linhas_trecho.append(f"De {s['de']} para {s['para']} com azimute {s['azimute']} e distância {s['distancia']}m")
            
            trecho_formatado = "; ".join(linhas_trecho)

            prompt = f"""
            Você é um assistente especialista em engenharia agrimensura e topografia jurídica.
            Escreva um parágrafo curto e perfeitamente técnico (em português) para descrever a confrontação perimétrica do imóvel de {dados_memorial['proprietario']} com o confrontante {confrontante}.
            
            Dados do trecho: {trecho_formatado}.
            
            O texto deve ser fluido e formal, adequado para constar em uma DECLARAÇÃO DE RECONHECIMENTO DE LIMITES. Retorne APENAS o parágrafo gerado, sem explicações, saudações ou markdown adicionais.
            """
            
            # Utiliza o modelo flash configurado na sua plataforma
            model = genai.GenerativeModel('gemini-1.5-flash')
            resposta = model.generate_content(prompt)
            return resposta.text.strip()
            
        except Exception as e:
            logger.error(f"Erro na chamada do Gemini para anuências: {str(e)}")
            return f"O limite perimétrico com {confrontante} inicia-se nos vértices descritos na tabela técnica em anexo."

    def gerar_documento(self, confrontante: str, dados_memorial: dict, segmentos: list) -> bytes:
        """
        Gera o arquivo binário .docx da Anuência baseado estritamente no modelo fornecido pelo usuário.
        """
        doc = Document()

        # Configuração de Margens Padrão (2.5 cm)
        for section in doc.sections:
            section.top_margin = Inches(1)
            section.bottom_margin = Inches(1)
            section.left_margin = Inches(1)
            section.right_margin = Inches(1)

        # Configuração de Estilo de Fonte
        style = doc.styles['Normal']
        font = style.font
        font.name = 'Calibri'
        font.size = Pt(11)

        # 1. TÍTULO (Centralizado e Negrito)
        p_titulo = doc.add_paragraph()
        p_titulo.alignment = WD_ALIGN_PARAGRAPH.CENTER
        run_title = p_titulo.add_run("DECLARAÇÃO DE RECONHECIMENTO DE LIMITES")
        run_title.bold = True
        run_title.font.size = Pt(14)
        doc.add_paragraph("") # Espaçamento

        # 2. TEXTO DE ABERTURA
        texto_abertura = (
            f"Eu, {confrontante.title()}, proprietário do imóvel confrontante, e eu, "
            f"{dados_memorial['proprietario'].title()}, proprietário do imóvel urbano, declaramos não "
            f"existir nenhuma disputa ou discordância sobre os limites comuns existentes entre os citados imóveis."
        )
        p_abertura = doc.add_paragraph(texto_abertura)
        p_abertura.paragraph_format.line_spacing = 1.15
        p_abertura.paragraph_format.space_after = Pt(12)

        # 3. DESCRIÇÃO DO TRECHO (Gerado dinamicamente pela API do Gemini)
        p_desc_titulo = doc.add_paragraph()
        p_desc_titulo.add_run("Descrição do trecho de confrontação:").bold = True
        
        texto_gemini = self.analisar_e_estruturar_texto(confrontante, dados_memorial, segmentos)
        p_desc_corpo = doc.add_paragraph(texto_gemini)
        p_desc_corpo.paragraph_format.line_spacing = 1.15
        p_desc_corpo.paragraph_format.space_after = Pt(12)

        # 4. TABELA TÉCNICA DO TRECHO
        tabela = doc.add_table(rows=1, cols=7)
        tabela.style = 'Light Shading Accent 1' # Estilo elegante padrão Word
        
        hdr_cells = tabela.rows[0].cells
        headers = ["De", "Para", "Azimute", "Distância (m)", "E(X)", "N(Y)", "Altitude"]
        for i, header in enumerate(headers):
            hdr_cells[i].text = header
            hdr_cells[i].paragraphs[0].runs[0].font.bold = True

        total_distancia = 0.0
        for s in segmentos:
            row_cells = tabela.add_row().cells
            row_cells[0].text = str(s['de'])
            row_cells[1].text = str(s['para'])
            row_cells[2].text = str(s['azimute'])
            
            dist = float(str(s['distancia']).replace(',', '.'))
            total_distancia += dist
            row_cells[3].text = f"{dist:.2f}".replace('.', ',')
            
            row_cells[4].text = str(s.get('e_x', '0,00'))
            row_cells[5].text = str(s.get('n_y', '0,00'))
            row_cells[6].text = "0,00"

        # Linha de Totais da Tabela
        row_totais = tabela.add_row().cells
        row_totais[0].text = "Total"
        row_totais[0].paragraphs[0].runs[0].font.bold = True
        row_totais[3].text = f"{total_distancia:.2f}".replace('.', ',')
        row_totais[3].paragraphs[0].runs[0].font.bold = True

        doc.add_paragraph("") # Espaçamento pós-tabela

        # 5. TEXTO DE RESPONSABILIDADE TÉCNICA
        trt_cod = self.dados_tecnico.get("trt", "BR20260312846")
        texto_tecnico = (
            f"Declaramos ainda que o profissional {self.dados_tecnico['nome']} (CFTA {self.dados_tecnico['cfta']}), "
            f"Resp. Técnico, credenciado pelo INCRA sob o cod. G1D, com a emissão da TRT nº {trt_cod}, nos indicou "
            f"as demarcações do limite entre as nossas propriedades, tanto no campo como nas suas apresentações gráficas. "
            f"Concordamos com essa demarcação, expressa na planta e no memorial descritivo, ambos em anexo, e reconhecemos "
            f"esta descrição como o limite legal entre nossas propriedades."
        )
        p_tecnico = doc.add_paragraph(texto_tecnico)
        p_tecnico.paragraph_format.line_spacing = 1.15
        p_tecnico.paragraph_format.space_after = Pt(24)

        # 6. DATA E LOCALIDADE
        cidade_data = f"{dados_memorial.get('local', 'Vila Valério')} – ES, {dados_memorial.get('data_doc', '30 de março de 2026')}."
        p_data = doc.add_paragraph(cidade_data)
        p_data.paragraph_format.space_after = Pt(36)

        # 7. CAMPOS DE ASSINATURA (Tabela invisível de duas colunas)
        tab_assinatura = doc.add_table(rows=2, cols=2)
        tab_assinatura.autofit = True
        
        celulas_linha1 = tab_assinatura.rows[0].cells
        celulas_linha1[0].text = "__________________________________________________"
        celulas_linha1[1].text = "__________________________________________________"
        
        celulas_linha2 = tab_assinatura.rows[1].cells
        celulas_linha2[0].text = f"{confrontante.title()}\nProprietário do Imóvel Confrontante"
        celulas_linha2[1].text = f"{dados_memorial['proprietario'].title()}\nProprietário do Imóvel"

        doc.add_paragraph("\n\n")

        # 8. ASSINATURA DO RESPONSÁVEL TÉCNICO
        p_ass_tec = doc.add_paragraph()
        p_ass_tec.alignment = WD_ALIGN_PARAGRAPH.CENTER
        p_ass_tec.add_run("______________________________\n").bold = True
        p_ass_tec.add_run(f"{self.dados_tecnico['nome']}\nResp. Técnico\nCFTA: {self.dados_tecnico['cfta']}")

        # Retorna o arquivo como array de bytes para download estável no Streamlit
        buffer = io.BytesIO()
        doc.save(buffer)
        buffer.seek(0)
        return buffer.getvalue()
