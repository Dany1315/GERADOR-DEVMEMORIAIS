    # ==========================================
    # PROCESSAMENTO E GERAÇÃO DE ANUÊNCIAS
    # ==========================================
    processamento_iniciado = False
    if pdf_memorial or texto_memorial_manual:
        if st.button("🔄 Processar Memorial e Identificar Confrontantes", type="primary", use_container_width=True):
            processamento_iniciado = True
            tempo_inicio_geral = datetime.now()

            try:
                # Configurar Gemini
                if not genai.configure(api_key=st.secrets.get("GEMINI_API_KEY")):
                    st.error("❌ Erro: Chave GEMINI_API_KEY não configurada nos Streamlit Secrets.")
                    st.stop()
                
                model_mapping = {
                    "Gemini 3.5 Flash": "gemini-3.5-flash",
                    "Gemini 3.1 Pro": "gemini-3.1-pro",
                    "Gemini 3.1 Flash Lite": "gemini-3.1-flash-lite",
                    "Gemini 2.5 Pro": "gemini-2.5-pro",
                    "Gemini 2.5 Flash": "gemini-2.5-flash",
                }
                nome_modelo_api = model_mapping.get(nome_modelo, "gemini-3.5-flash")

                # Extração de dados do memorial
                st.info("⏳ Processando memorial...")
                
                imagens_memorial = []
                texto_extraido = ""

                if pdf_memorial:
                    st.info("🖼️ Convertendo PDF em imagem...")
                    imagens_memorial = pdf_paginas_para_imagens(pdf_memorial, dpi=dpi_conversao)
                    # Tenta extrair texto também, se possível
                    try:
                        texto_extraido = extrair_texto_pdf(pdf_memorial)
                    except: pass # Ignora erro se não tiver texto
                
                if texto_memorial_manual:
                    texto_extraido = texto_memorial_manual

                # Usar IA para mapear confrontantes e segmentos
                st.info("🤖 Mapeando confrontantes e segmentos com IA...")
                mapeamento = mapear_confrontantes_gemini(
                    nome_modelo=nome_modelo_api,
                    imagens_planta=imagens_memorial if imagens_memorial else None,
                    texto_planta=texto_extraido if texto_extraido else None,
                    texto_roteiro=None # Não há roteiro separado, o memorial já contém tudo
                )

                if not mapeamento or not mapeamento.regras:
                    st.warning("⚠️ Nenhum confrontante ou segmento foi extraído do memorial. Verifique o conteúdo.")
                    st.stop()

                # Simular segmentos do roteiro para vincular confrontantes
                # Para anuência, precisamos dos segmentos com as coordenadas de cada ponto.
                # O mapeamento acima já deveria ter extraído isso. Vamos ajustar a estrutura.
                # A ideia é que o mapeamento retorne os segmentos já com os confrontantes.
                # Para simplificar, vamos assumir que o mapeamento.regras já tem os confrontantes
                # e que precisamos dos segmentos brutos para a tabela.
                
                # Para este gerador de anuências, vamos precisar de uma forma de extrair
                # os segmentos do memorial. Se o memorial já tem a descrição, podemos tentar
                # extrair os segmentos diretamente dela.
                
                # Por simplicidade, vamos assumir que o prompt de mapear_confrontantes_gemini
                # já nos dá os segmentos com os confrontantes. Se não, precisaríamos de uma
                # função extra para isso.

                # A função mapear_confrontantes_gemini precisa ser adaptada para retornar
                # os segmentos detalhados, não apenas as regras de confrontação.
                # Para este caso, vamos precisar de um prompt mais específico para extrair
                # os segmentos com N, E, Azimute, Distância.

                # Re-executando a extração de roteiro com IA para obter os segmentos detalhados
                st.info("📊 Extraindo detalhes dos segmentos com IA...")
                segmentos_detalhados = extrair_roteiro_com_ia(imagens_memorial, nome_modelo_api) if imagens_memorial else parse_tabela_roteiro(texto_extraido)

                if not segmentos_detalhados:
                    st.error("❌ Não foi possível extrair os segmentos detalhados do memorial.")
                    st.stop()

                # Vincular confrontantes aos segmentos detalhados
                segmentos_finais = vincular_confrontantes(segmentos_detalhados, mapeamento)

                st.session_state["dados_processados"] = {
                    "segmentos": segmentos_finais,
                    "proprietario_principal": cliente_proprietario,
                    "local_principal": cliente_local,
                    "empresa_info": {
                        "nome": empresa_nome,
                        "endereco": empresa_endereco,
                        "telefone": empresa_telefone,
                        "email": empresa_email
                    },
                    "tecnico_info": {
                        "nome": tecnico_nome,
                        "cfta": tecnico_cfta
                    }
                }
                st.session_state["processamento_concluido_anuencia"] = True
                st.success("✅ Memorial processado! Selecione o confrontante abaixo para gerar a anuência.")

            except Exception as e:
                st.error(f"❌ Erro no processamento: {str(e)}")
                logger.error(f"Erro geral no processamento de anuência: {str(e)}", exc_info=True)

    if st.session_state.get("processamento_concluido_anuencia"):
        dados_processados = st.session_state["dados_processados"]
        segmentos_com_confrontantes = dados_processados["segmentos"]

        confrontantes_unicos = sorted(list(set([s["confrontante"] for s in segmentos_com_confrontantes if s["confrontante"] not in ["", "CONFRONTAÇÃO NÃO ENCONTRADA"]])))

        if not confrontantes_unicos:
            st.warning("⚠️ Nenhum confrontante válido encontrado para gerar anuência.")
        else:
            st.subheader("🤝 Gerar Termo de Anuência")
            confrontante_selecionado = st.selectbox(
                "Selecione o Confrontante:",
                options=confrontantes_unicos,
                key="confrontante_anuencia_select"
            )

            segmentos_para_anuencia = [s for s in segmentos_com_confrontantes if s["confrontante"] == confrontante_selecionado]

            if st.button(f"📝 Gerar Anuência para {confrontante_selecionado}", type="secondary", use_container_width=True):
                try:
                    gerador_an = GeradorAnuenciaWord(
                        dados_processados["empresa_info"],
                        dados_processados["tecnico_info"]
                    )
                    
                    dados_anuencia = {
                        "proprietario": dados_processados["proprietario_principal"],
                        "confrontante": confrontante_selecionado,
                        "local": dados_processados["local_principal"],
                        "segmentos": segmentos_para_anuencia
                    }

                    arquivo_docx = gerador_an.gerar_documento(dados_anuencia)

                    st.success(f"✅ Termo de Anuência para {confrontante_selecionado} gerado com sucesso!")
                    nome_conf_limpo = confrontante_selecionado.replace(' ', '_').replace('/', '_').upper()
                    st.download_button(
                        label=f"📥 Baixar Anuência - {confrontante_selecionado}.docx",
                        data=arquivo_docx,
                        file_name=f"ANUENCIA_{nome_conf_limpo}_{datetime.now().strftime('%Y%m%d')}.docx",
                        mime="application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                        use_container_width=True
                    )
                except Exception as e:
                    st.error(f"❌ Erro ao gerar anuência: {str(e)}")
                    logger.error(f"Erro na geração de anuência para {confrontante_selecionado}: {str(e)}", exc_info=True)


if __name__ == "__main__":
    main()
